{
  "name": "local-agent-usage",
  "version": "0.1.0",
  "description": "Visualize local AI coding-agent token usage (Claude Code + OpenAI Codex CLI) from local logs as an HTML dashboard.",
  "type": "module",
  "bin": {
    "local-agent-usage": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "tui": "node dist/cli.js --tui",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai",
    "usage",
    "tokens",
    "cli",
    "dashboard"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  }
}
